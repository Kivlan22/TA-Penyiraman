<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Define colors -->
    <color name="purple_500">#6200EE</color>
    <color name="purple_700">#3700B3</color>

    <!-- Define custom theme -->
    <style name="Theme.TaApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_500</item> <!-- Additional color if needed -->
    </style>

    <!-- Make sure to set your app theme to the custom theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorPrimaryDark">@color/purple_700</item>
        <item name="android:colorAccent">@color/purple_500</item>
    </style>
</resources>
